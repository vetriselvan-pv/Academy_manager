    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
